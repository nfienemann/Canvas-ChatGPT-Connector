+                assert staged["status"] == "ok"
+                write(
+                    "native/pre-restart.json",
+                    dict(observation=observation.model_dump(mode="json"), result=staged),
+                )
+        async with running(settings) as pid2:
+            write("native/restart.json", dict(before=pid, after=pid2))
+            await host(
+                "amendment",
+                "review_changes",
