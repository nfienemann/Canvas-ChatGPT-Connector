+        assert {x["content_hash"] for x in review["bindings"]} == {x["content_hash"] for x in first}
+        key = rd.save(
+            bridge.processes,
+            owner,
+            rd.Review.model_validate(review | dict(bindings=first, course="BenchLink")),
