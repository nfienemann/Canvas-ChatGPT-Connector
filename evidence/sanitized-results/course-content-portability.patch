+"""Current deletion continuity comes from a trusted live store, never the bundle."""
+
+import sqlite3
+from contextlib import contextmanager
+from pathlib import Path
+
+from sqlalchemy import create_engine, select
+from sqlalchemy.exc import SQLAlchemyError
+from sqlalchemy.orm import Session
+
+from canvas_bridge.domain import DomainError
+from canvas_bridge.storage import IndependentResource, aware
+from canvas_bridge.usefulness.packet import binding
+from canvas_bridge.usefulness.workspace_package import refuse
+
+
+@contextmanager
+def authority(bridge, local_session):
+    path = bridge.settings.portability_origin_sqlite
+    if path is None:
+        yield local_session
+        return
+    path = Path(path).resolve()
+    database = bridge.store.engine.url.database
+    if database and Path(database).resolve() == path:
+        yield local_session
+        return
+    # Only the operator configures this path. Read-only rollback-journal mode
+    # holds a shared lock until the destination commit exits the inner context.
+    engine = create_engine(
+        "sqlite://",
+        creator=lambda: sqlite3.connect(path.as_uri() + "?mode=ro", uri=True, timeout=2),
+    )
+    engine.dialect.bridge_vault = bridge.vault
+    try:
+        with Session(engine) as session:
+            conn = session.connection()
+            if conn.exec_driver_sql("PRAGMA journal_mode").scalar().lower() != "delete":
+                refuse("PORT_AUTHORITY_UNAVAILABLE", "Use a current supported source authority.")
+            conn.exec_driver_sql("BEGIN")
+            yield session
+    except (SQLAlchemyError, sqlite3.Error, OSError, ValueError):
+        refuse(
+            "PORT_AUTHORITY_UNAVAILABLE", "The configured current source authority is unavailable."
+        )
+    finally:
+        engine.dispose()
+
+
+def current_doc(bridge, session, owner, ident, now):
+    row = session.get(IndependentResource, ident)
+    if (
+        row is None
+        or row.owner != owner
+        or row.kind != "local_document"
+        or aware(row.expires_at) <= now
+        or row.content.get("portable_origin")
+    ):
+        refuse("PORT_SOURCE_UNAVAILABLE", "The original source is unavailable or expired.")
+    bridge.independent.require_row(session, owner, row)
+    contexts = session.scalars(
+        select(IndependentResource).where(
+            IndependentResource.owner == owner,
+            IndependentResource.kind == "integrity_context",
+            IndependentResource.expires_at > now,
+        )
+    )
+    if any(
+        ident in ctx.content.get("hashes", {}) and ctx.content.get("scope", {}).get("connection_id")
+        for ctx in contexts
+    ):
+        refuse(
+            "PORT_INSTITUTIONAL_EXPORT_UNAVAILABLE",
+            "This source retains an institutional dependency.",
+        )
+    p = row.provenance
+    if (
+        p.get("owner") != owner
+        or p.get("source_type") != "local_document"
+        or p.get("content_identity") != row.version_hash
+        or p.get("parents")
+        or p.get("institutional_connection") is not None
+        or p.get("origin") != "authenticated_browser_upload"
+        or p.get("authorization") != "explicit_user_permission"
+        or p.get("schema_version") != "source-provenance-1"
+        or p.get("copyright") != "owner_attested"
+        or p.get("source_category", "independent_import") != "independent_import"
+    ):
+        refuse("PORT_SOURCE_UNAVAILABLE", "Review current ownership and source eligibility.")
+    bridge.independent.reject_institutional_copy(session, owner, row.version_hash)
+    return row
+
+
+def verify_restored_source(bridge, session, row):
+    ref = row.content.get("portable_origin")
+    if ref:
+        with authority(bridge, session) as origin:
+            source = current_doc(bridge, origin, row.owner, ref["source"], bridge.retention.clock())
+            if (
+                binding(source) != ref["binding"]
+                or source.version_hash != row.version_hash
+                or source.provenance.get("permission_version", 0) != ref["permission_version"]
+            ):
+                raise DomainError(
+                    "permission_denied", "The original source policy or version changed."
+                )
+
+
+def require_original_grant(bridge, session, row, *, share, visual, scope, profile, external):
+    ref = row.content.get("portable_origin")
+    if not ref:
+        return
+    with authority(bridge, session) as origin:
+        source = current_doc(bridge, origin, row.owner, ref["source"], bridge.retention.clock())
+        p = source.provenance
+        if (
+            not set(scope) <= set(p.get("scope", []))
+            or share
+            and (
+                not p.get("share_text")
+                or not profile
+                or p.get("egress_policy") != profile.model_dump(mode="json")
+            )
+            or visual
+            and not p.get("share_visual")
+            or external
+            and p.get("external_egress_policy") != external.model_dump(mode="json")
+        ):
+            refuse(
+                "PORT_ORIGINAL_GRANT_REQUIRED",
+                "Review the permitted purpose and recipient at the original source.",
+            )
diff --git a/src/canvas_bridge/usefulness/workspace_ui.py b/src/canvas_bridge/usefulness/workspace_ui.py
new file mode 100644
--- /dev/null
+++ b/src/canvas_bridge/usefulness/workspace_ui.py
@@ -0,0 +1,195 @@
+"""Workspace portability uses only authenticated, CSRF-protected settings forms."""
+
+import secrets
+from urllib.parse import urlsplit
+
+from starlette.responses import Response
+
+from canvas_bridge.domain import DomainError
+from canvas_bridge.usefulness.workspace import Workspace
+from canvas_bridge.usefulness.workspace_package import LIMIT
+
+
+def register(bridge, route, identity, form, page, hidden):
+    from canvas_bridge.usefulness.ui import esc
+
+    workspace = Workspace(bridge)
+
+    @route("/settings/materials/workspace", ["GET"])
+    async def selection(request):
+        session = await identity(request)
+        bridge.usefulness.enabled()
+        course = request.query_params.get("course", "independent")
+        body = (
+            '<form method="get"><label>Course <input name="course" maxlength="100" value="'
+            + esc(course)
+            + '"></label><button>Choose course</button></form>'
+        )
+        body += (
+            '<form method="post" action="/settings/materials/workspace/export">'
+            + hidden("csrf", session.csrf)
+            + hidden("course", course)
+        )
+        for doc in bridge.independent.list(session.owner).data["documents"]:
+            if doc["course"] == course:
+                body += (
+                    '<label><input type="checkbox" name="document" value="'
+                    + esc(doc["document_id"])
+                    + '">'
+                    + esc(doc["filename"])
+                    + "</label>"
+                )
+        state = workspace.repo.inventory(session.owner)
+        for record in state["records"]:
+            if record.get("course") == course:
+                body += (
+                    '<label><input type="checkbox" name="record" value="'
+                    + esc(record["id"])
+                    + '">'
+                    + esc(record["kind"] + " · " + record["id"])
+                    + "</label>"
+                )
+        body += '<label><input type="checkbox" name="originals">Include eligible original source bytes</label><label><input type="checkbox" name="preferences">Include personal study preferences</label><button>Download selection</button></form>'
+        body += (
+            '<h2>Restore a selection</h2><form method="post" enctype="multipart/form-data" action="/settings/materials/workspace/preview">'
+            + hidden("csrf", session.csrf)
+            + '<label>Course workspace file<input type="file" name="bundle" required></label><button>Preview restore</button></form>'
+        )
+        return page("Course workspace export and restore", body)
+
+    @route("/settings/materials/workspace/export", ["POST"])
+    async def export(request):
+        session = await identity(request, True)
+        values = await form(request, session)
+        raw = workspace.export(
+            session.owner,
+            str(values.get("course", "")),
+            values.getlist("record"),
+            values.getlist("document"),
+            originals=values.get("originals") == "on",
+            preferences=values.get("preferences") == "on",
+            recipient=session.egress_identity,
+            generation=request.state.validate_bridge_session(),
+        )
+        return Response(
+            raw,
+            media_type="application/zip",
+            headers={
+                "Cache-Control": "no-store",
+                "Content-Disposition": 'attachment; filename="course-workspace.cbworkspace"',
+            },
+        )
+
+    @route("/settings/materials/workspace/preview", ["POST"])
+    @route("/settings/materials/workspace/restore", ["POST"])
+    async def restore(request):
+        session = await identity(request, True)
+        bridge.usefulness.enabled()
+        root = urlsplit(bridge.settings.resource_url)
+        if request.headers.get("origin") != f"{root.scheme}://{root.netloc}":
+            raise DomainError("permission_denied", "Review the workspace from signed-in settings.")
+        body = bytearray()
+        async for chunk in request.stream():
+            if len(body) + len(chunk) > LIMIT + 16_000:
+                raise DomainError("needs_input", "Choose a smaller course workspace.")
+            body.extend(chunk)
+        request._body = bytes(body)
+        async with request.form(max_files=1, max_fields=100, max_part_size=16_000) as values:
+            if not secrets.compare_digest(str(values.get("csrf", "")), session.csrf):
+                raise DomainError("permission_denied", "Reload the signed-in restore form.")
+            upload = values.get("bundle")
+            if upload is None or not hasattr(upload, "read"):
+                raise DomainError("needs_input", "Select the exact exported workspace.")
+            raw = await upload.read(LIMIT + 1)
+            commit = request.url.path.endswith("/restore")
+            confirmation = str(values.get("confirmation", "")) if commit else None
+            if commit and not confirmation:
+                raise DomainError("needs_input", "Review an exact restore preview first.")
+            choices = values.getlist("replace")
+            result = workspace.restore(
+                session.owner,
+                raw,
+                generation=request.state.validate_bridge_session(),
+                choices=choices,
+                confirmation=confirmation,
+                key=values.get("key"),
+            )
+        history = {
+            "current_store": "this installation",
+            "paired_live_sqlite": "the paired live origin",
+        }.get(result.get("history_authority"))
+        assurance = (
+            "<p>Source and deletion history verified against " + history + ".</p>"
+            if history
+            else ""
+        )
+        if commit:
+            body = (
+                "<p>"
+                + esc(result["status"])
+                + " · "
+                + str(result["document_count"])
+                + " sources created, "
+                + str(result["record_count"])
+                + " records written.</p>"
+                + assurance
+            )
+            outcomes = result.get("outcomes", {})
+        else:
+            body = (
+                "<p>Eligible records commit together. Unresolved records stay in the selected file.</p>"
+                + assurance
+            )
+            outcomes = result
+        for group in ("documents", "records"):
+            for ident, item in outcomes.get(group, {}).items():
+                body += (
+                    "<p>"
+                    + esc(ident)
+                    + " · "
+                    + esc(item["action"])
+                    + " "
+                    + esc(item.get("reason", ""))
+                    + "</p>"
+                )
+        if outcomes.get("preferences"):
+            body += "<p>Preferences · " + esc(outcomes["preferences"]["action"]) + "</p>"
+        for item in outcomes.get("omitted", []):
+            body += "<p>" + esc(item["id"]) + " · " + esc(item["reason"]) + "</p>"
+        if commit:
+            return page("Restore receipt", body)
+        for endpoint in ("preview", "restore"):
+            body += (
+                '<form method="post" enctype="multipart/form-data" action="/settings/materials/workspace/'
+                + endpoint
+                + '">'
+                + hidden("csrf", session.csrf)
+            )
+            if endpoint == "restore":
+                body += hidden("confirmation", result["preview_id"]) + hidden(
+                    "key", secrets.token_urlsafe(24)
+                )
+                body += "".join(hidden("replace", c) for c in choices)
+            else:
+                items = result["records"] | (
+                    {"preferences": result["preferences"]} if result["preferences"] else {}
+                )
+                for ident, item in items.items():
+                    if item["action"] in {"conflict", "replace"}:
+                        body += (
+                            '<label><input type="checkbox" name="replace" value="'
+                            + esc(ident)
+                            + '">Replace '
+                            + esc(ident)
+                            + "</label>"
+                        )
+            body += (
+                '<label>Reselect the reviewed workspace file<input type="file" name="bundle" required></label><button>'
+                + (
+                    "Review conflict choices"
+                    if endpoint == "preview"
+                    else "Confirm eligible changes"
+                )
+                + "</button></form>"
+            )
+        return page("Review workspace restore", body)
diff --git a/src/canvas_bridge/usefulness/workspace_package.py b/src/canvas_bridge/usefulness/workspace_package.py
new file mode 100644
--- /dev/null
+++ b/src/canvas_bridge/usefulness/workspace_package.py
@@ -0,0 +1,166 @@
+"""Bounded student workspace archive. A manifest records evidence, never grants."""
+
+import base64
+import io
+import json
+import re
+import stat
+import zipfile
+from hashlib import sha256
+
+from canvas_bridge.domain import DomainError
+from canvas_bridge.processes.state import read_portable_export
+
+SCHEMA = "course-workspace-1"
+LIMIT = 50_000_000
+MANIFEST_LIMIT = 2_000_000
+
+
+def refuse(code, message):
+    raise DomainError("needs_input", message, reason_code=code)
+
+
+def pack(manifest, payloads):
+    body = json.dumps(manifest, ensure_ascii=False, allow_nan=False).encode()
+    if len(body) > MANIFEST_LIMIT or sum(map(len, payloads.values())) + len(body) > LIMIT - 64_000:
+        refuse("PORT_PACKAGE_LIMIT", "Reduce the selected course records or payloads.")
+    output = io.BytesIO()
+    with zipfile.ZipFile(output, "w", compression=zipfile.ZIP_STORED) as archive:
+        archive.writestr("manifest.json", body)
+        for digest, data in sorted(payloads.items()):
+            archive.writestr("payloads/" + digest, data)
+    return output.getvalue()
+
+
+def unique(pairs):
+    result = {}
+    for key, value in pairs:
+        if key in result:
+            raise ValueError
+        result[key] = value
+    return result
+
+
+def unpack(raw, owner):
+    if len(raw) > LIMIT:
+        refuse("PORT_PACKAGE_LIMIT", "Choose a workspace package within 50 MB.")
+    try:
+        with zipfile.ZipFile(io.BytesIO(raw)) as archive:
+            entries = archive.infolist()
+            if len(entries) > 221 or len({i.filename for i in entries}) != len(entries):
+                raise ValueError
+            payloads = {}
+            body = None
+            for entry in entries:
+                manifest = entry.filename == "manifest.json"
+                if (
+                    not manifest
+                    and not re.fullmatch(r"payloads/[a-f0-9]{64}", entry.filename)
+                    or entry.orig_filename != entry.filename
+                    or entry.flag_bits & 1
+                    or entry.compress_type != zipfile.ZIP_STORED
+                    or stat.S_ISLNK(entry.external_attr >> 16)
+                    or entry.compress_size != entry.file_size
+                    or entry.file_size > (MANIFEST_LIMIT if manifest else 10_000_000)
+                ):
+                    raise ValueError
+                value = archive.read(entry)
+                if len(value) != entry.file_size:
+                    raise ValueError
+                if manifest:
+                    body = value
+                else:
+                    digest = sha256(value).hexdigest()
+                    if entry.filename != "payloads/" + digest:
+                        raise ValueError
+                    payloads[digest] = value
+            if body is None:
+                raise ValueError
+            manifest = json.loads(body.decode("utf8"), object_pairs_hook=unique)
+        if manifest["schema_version"] != SCHEMA:
+            refuse(
+                "PORT_SCHEMA_UNSUPPORTED",
+                "This workspace format requires a compatible Bridge version.",
+            )
+        if manifest["owner"] != owner:
+            refuse(
+                "PORT_OWNER_MISMATCH", "Open this selection under its verified original identity."
+            )
+        if (
+            not re.fullmatch("[a-f0-9]{32}", manifest["export_id"])
+            or type(manifest["generation"]) is not int
+            or manifest["generation"] < 0
+        ):
+            raise ValueError
+        from copy import deepcopy
+
+        process = deepcopy(manifest["process"])
+        links = manifest.get("link_versions", {})
+        if not isinstance(links, dict) or set(links) - {r["id"] for r in process["records"]}:
+            raise ValueError
+        for rec in process["records"]:
+            if rec["id"] not in links:
+                continue
+            if rec["kind"] != "identity" or "revision" in rec or type(links[rec["id"]]) is not int:
+                raise ValueError
+            rec["revision"] = links[rec["id"]]
+            data = rec["data"]
+            groups = [data["canonical_link_proposal"], *data.get("canonical_inventory", [])]
+            for group in groups:
+                for alias in group["aliases"]:
+                    alias.setdefault("instructor", None)
+                    for scoped in (alias, *alias["sources"]):
+                        if scoped["scope"].setdefault("principal", owner) != owner:
+                            raise ValueError
+        records = read_portable_export(process, owner=owner)
+        if not isinstance(manifest["documents"], list) or len(manifest["documents"]) > 20:
+            raise ValueError
+        documents = {d["id"]: d for d in manifest["documents"]}
+        if len(documents) != len(manifest["documents"]):
+            raise ValueError
+        required = set()
+        for doc in documents.values():
+            for version in doc["versions"]:
+                digest = version["hash"]
+                if not re.fullmatch("[a-f0-9]{64}", digest):
+                    raise ValueError
+                if version["payload"] == "included":
+                    required.add(digest)
+                    if len(payloads[digest]) != version["size"]:
+                        raise ValueError
+                elif version["payload"] != "reference_only":
+                    raise ValueError
+        if required != set(payloads):
+            raise ValueError
+    except (
+        AttributeError,
+        KeyError,
+        TypeError,
+        ValueError,
+        RuntimeError,
+        zipfile.BadZipFile,
+        RecursionError,
+        OSError,
+        NotImplementedError,
+    ):
+        refuse(
+            "PORT_PACKAGE_INVALID", "The workspace inventory, payload, or schema failed validation."
+        )
+    return manifest, documents, records, payloads
+
+
+def version(raw, digest, locator, acquired, include, payloads):
+    data = base64.b64decode(raw, validate=True)
+    if sha256(data).hexdigest() != digest:
+        refuse("PORT_SOURCE_CHANGED", "The selected source failed its byte identity check.")
+    if include:
+        if digest not in payloads and sum(map(len, payloads.values())) + len(data) > LIMIT:
+            refuse("PORT_PACKAGE_LIMIT", "Reduce the selected original byte inventory.")
+        payloads[digest] = data
+    return {
+        "hash": digest,
+        "size": len(data),
+        "locator": locator,
+        "acquired_at": acquired,
+        "payload": "included" if include else "reference_only",
+    }
diff --git a/tests/test_content_portability.py b/tests/test_content_portability.py
new file mode 100644
--- /dev/null
+++ b/tests/test_content_portability.py
@@ -0,0 +1,802 @@
+"""Synthetic course packet acceptance through the authenticated settings route."""
+
+import io
+import json
+import zipfile
+from hashlib import sha256
+from urllib.parse import quote
+
+import pytest
+
+from tests.test_recovery_independence import parsed_locally as parsed_locally
+from tests.test_usefulness import ui as ui
+
+
+@pytest.fixture(autouse=True)
+def enable(bridge):
+    bridge.settings.usefulness_features_enabled = True
+    bridge.settings.process_features_enabled = True
+
+
+def archive(members):
+    stream = io.BytesIO()
+    with zipfile.ZipFile(stream, "w") as output:
+        for name, value in members:
+            output.writestr(name, value)
+    return stream.getvalue()
+
+
+async def upload(
+    ui,
+    members,
+    key,
+    *,
+    term="fall",
+    role="material",
+    course="MKT",
+    expected=None,
+    decisions=None,
+    commit=True,
+):
+    payload = archive(members)
+    headers = {
+        "X-Bridge-CSRF": "usefulness-csrf",
+        "X-Bridge-Own": "true",
+        "X-Bridge-Key": key,
+        "X-Bridge-Filename": "packet.zip",
+        "X-Bridge-Term": term,
+        "X-Bridge-Purpose": role,
+        "X-Bridge-Course": course,
+        "X-Bridge-Expected": quote(json.dumps(expected or {})),
+        "X-Bridge-Mappings": quote(json.dumps(decisions or {})),
+        "Content-Type": "application/zip",
+    }
+
+    async def post(extra):
+        response = await ui.post(
+            "/settings/materials/import", content=payload, headers=headers | extra
+        )
+        assert response.status_code == 200, response.text
+        return response.json()
+
+    review = await post({"X-Bridge-Preview": "true"})
+    if not commit:
+        return review
+    return await post({"X-Bridge-Confirmation": review["preview_id"]})
+
+
+async def test_packet_move_revision_reorder_and_scopes(ui, bridge, owner, parsed_locally):
+    original = [("unit/a.txt", "Memo due Nov 2."), ("unit/b.md", "Feedback.")]
+    first = await upload(ui, original, "first")
+    assert first["state"] == "ready"
+    old, feedback = first["items"]
+    longpath = "chapter/" * 50 + "reading.txt"
+    moved = await upload(ui, [original[1], (longpath, original[0][1])], "moved")
+    assert [i["disposition"] for i in moved["items"]] == ["unchanged", "relocated"]
+    assert moved["items"][1]["document_id"] == old["document_id"]
+    for field in ("role", "term", "course"):
+        other = await upload(ui, original[:1], field, **{field: "reading"})
+        assert other["items"][0]["binding"] != old["binding"]
+        assert other["items"][0]["document_id"] != old["document_id"]
+    rev = await upload(ui, [("unit/a.txt", "Memo due Nov 4.")], "revision")
+    item = rev["items"][0]
+    assert item["disposition"] == "new_version" and item["binding"] == old["binding"]
+    row = bridge.independent.require(owner, item["document_id"])
+    assert row.content["version_history"][-1]["hash"] == old["content_hash"]
+    assert row.content["version_history"][-1]["logical_path"] == longpath
+    assert (
+        bridge.independent.require(owner, feedback["document_id"]).version_hash
+        == feedback["content_hash"]
+    )
+
+
+async def test_review_ambiguous_exact_bytes(ui, parsed_locally):
+    first = await upload(ui, [("left.txt", "same"), ("right.txt", "same")], "first")
+    review = await upload(ui, [("moved.txt", "same")], "review", commit=False)
+    item = review["items"][0]
+    assert item["disposition"] == "ambiguous"
+    target = first["items"][0]["document_id"]
+    assert target in item["candidates"]
+    result = await upload(ui, [("moved.txt", "same")], "chosen", decisions={"moved.txt": target})
+    assert result["items"][0]["document_id"] == target
+
+
+async def test_recover_incremental_selection(ui, bridge, owner, parsed_locally):
+    detail = b"Feedback describes the design."
+    expected = {"feedback.md": sha256(detail).hexdigest(), "original-case.md": None}
+    available = [("brief.md", "Memo due Nov 2.")]
+    dropout = await upload(ui, available, "dropout", expected=expected)
+    assert all(m["retained_version"] is None for m in dropout["coverage"]["missing"])
+    wrong = await upload(ui, [("feedback.md", "unrelated")], "wrong", expected=expected)
+    assert wrong["items"][0]["state"] == "failed"
+    recovered = await upload(ui, [("feedback.md", detail)], "recovered", expected=expected)
+    assert recovered["items"][0]["content_hash"] == expected["feedback.md"]
+    partial = await upload(ui, available, "partial", expected=expected)
+    assert partial["coverage"]["missing"][0]["retained_version"] == expected["feedback.md"]
+    assert bridge.independent.require(owner, recovered["items"][0]["document_id"])
+
+
+@pytest.fixture
+def paired(settings, tmp_path):
+    from tests.conftest import bridge as build
+
+    path = tmp_path / "live-authority.sqlite"
+    source_settings = settings.model_copy(
+        update={
+            "database_url": "sqlite:///" + path.as_posix(),
+            "usefulness_features_enabled": True,
+            "process_features_enabled": True,
+        }
+    )
+    destination_settings = settings.model_copy(
+        update={
+            "portability_origin_sqlite": path,
+            "database_url": "sqlite:///" + (tmp_path / "destination.sqlite").as_posix(),
+            "usefulness_features_enabled": True,
+            "process_features_enabled": True,
+        }
+    )
+    sources = build.__wrapped__(source_settings)
+    destinations = build.__wrapped__(destination_settings)
+    try:
+        yield next(sources), next(destinations)
+    finally:
+        sources.close()
+        destinations.close()
+
+
+async def test_paired_workspace_roundtrip_and_revocation(
+    paired, owner, parsed_locally, monkeypatch
+):
+    from canvas_bridge.domain import DomainError
+    from canvas_bridge.storage import IndependentResource
+    from canvas_bridge.usefulness.workspace import Workspace
+    from canvas_bridge.usefulness.workspace_package import unpack
+    from tests.test_usefulness import import_text, reviewed
+
+    source, dest = paired
+    doc = await import_text(source, owner, "Memo due November 2, 2026.", course="MKT")
+    review = reviewed(source, owner, doc)
+    source.independent.preferences(owner, {"timezone": "UTC"})
+    raw = Workspace(source).export(
+        owner, "MKT", [review["record_id"]], [], originals=True, preferences=True
+    )
+    manifest, docs, recs, payloads = unpack(raw, owner)
+    assert payloads[doc.version_hash] == b"Memo due November 2, 2026."
+    api = Workspace(dest)
+    plan = api.restore(owner, raw, generation=0)
+    assert plan["history_authority"] == "paired_live_sqlite"
+    assert plan["source_id_map"] == {doc.id: doc.id}
+    assert plan["preferences"]["action"] == "create"
+    assert plan["records"][recs[0].id]["action"] == "create"
+    with pytest.raises(RuntimeError), monkeypatch.context() as scoped:
+
+        def interrupt(*args, **kwargs):
+            raise RuntimeError("injected before transaction commit")
+
+        scoped.setattr(api.repo, "_save", interrupt)
+        api.restore(owner, raw, generation=0, confirmation=plan["preview_id"], key="same")
+    assert dest.independent.list(owner).data["documents"] == []
+    done = api.restore(owner, raw, generation=0, confirmation=plan["preview_id"], key="same")
+    assert done["status"] == "complete"
+    assert done["history_authority"] == plan["history_authority"]
+    assert done["outcomes"]["records"] == plan["records"]
+    assert (
+        api.restore(owner, raw, generation=0, confirmation=plan["preview_id"], key="same") == done
+    )
+    restored = dest.independent.require(owner, doc.id)
+    assert not restored.provenance["share_text"]
+    assert (
+        restored.content["reviewed_dataset"]
+        == source.independent.require(owner, doc.id).content["reviewed_dataset"]
+    )
+    assert dest.independent.preferences(owner).data["value"]["timezone"] == "UTC"
+    with dest.store.transaction() as db:
+        container = db.get(IndependentResource, api.repo.identity(owner))
