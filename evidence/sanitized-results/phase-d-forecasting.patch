diff --git a/src/canvas_bridge/analytics/effort_history.py b/src/canvas_bridge/analytics/effort_history.py
new file mode 100644
--- /dev/null
+++ b/src/canvas_bridge/analytics/effort_history.py
@@ -0,0 +1,284 @@
+"""Scoped effort evidence for independent work episodes; no implicit activity tracking."""
+
+from datetime import UTC, datetime
+from fractions import Fraction
+from typing import Annotated, Literal
+
+from pydantic import AfterValidator, AwareDatetime, Field, model_validator
+
+from canvas_bridge.analytics.activity_metrics import mismatch
+from canvas_bridge.analytics.measurements import Actual, Forecast
+from canvas_bridge.processes.models import Model, Ref
+
+Instant = Annotated[AwareDatetime, AfterValidator(lambda t: t.astimezone(UTC))]
+Minutes = Annotated[int, Field(ge=0, le=100_000, strict=True)]
+
+
+class Interval(Model):
+    start: Instant
+    end: Instant
+
+    @model_validator(mode="after")
+    def ordered(self):
+        if self.end <= self.start:
+            raise ValueError("Use a positive elapsed interval.")
+        return self
+
+
+def union(intervals):
+    merged = []
+    for start, end in sorted(intervals):
+        if merged and start <= merged[-1][1]:
+            merged[-1] = (merged[-1][0], max(end, merged[-1][1]))
+        else:
+            merged.append((start, end))
+    return merged
+
+
+def elapsed(start, end):
+    return Fraction((end - start) // datetime.resolution, 60_000_000)
+
+
+class Estimate(Model):
+    low: Minutes | None = None
+    high: Minutes | None = None
+    point: Minutes | None = None
+
+    @model_validator(mode="after")
+    def ordered(self):
+        if (self.low is None) != (self.high is None) or (
+            self.low is None and self.point is not None
+        ):
+            raise ValueError("Supply both range endpoints or leave demand unknown.")
+        if self.low is not None and (
+            self.low > self.high
+            or self.point is not None
+            and not self.low <= self.point <= self.high
+        ):
+            raise ValueError("The point must fall inside an ordered range.")
+        return self
+
+
+class Reading(Model):
+    observation_id: Ref
+    revision: int = Field(ge=1)
+    known_at: Instant
+    scope_id: Ref
+    kind: Literal["duration_total", "active_interval"]
+    basis: Ref
+    minutes: Minutes | None = None
+    start: Instant | None = None
+    end: Instant | None = None
+    pauses: tuple[Interval, ...] = Field(default=(), max_length=32)
+    representation_group: Ref | None = None
+    logical_observation_id: Ref | None = None
+    retracted: bool = False
+
+    @model_validator(mode="after")
+    def valid(self):
+        if self.retracted:
+            return self
+        if self.kind == "active_interval":
+            if (
+                self.start is None
+                or self.end is None
+                or self.end <= self.start
+                or self.minutes is not None
+                or self.end > self.known_at
+            ):
+                raise ValueError("Supply a past active interval.")
+            if any(p.start < self.start or p.end > self.end for p in self.pauses):
+                raise ValueError("A pause must be within its session.")
+        elif self.minutes is None or self.start or self.end or self.pauses:
+            raise ValueError("Supply an explicit active-minute total.")
+        return self
+
+
+class Issued(Model):
+    forecast_id: Ref
+    scope_id: Ref
+    frozen_at: Instant
+    known_at: Instant
+    baseline: Estimate
+    published: Estimate
+    baseline_policy: Ref
+    baseline_origin: Ref
+    previous_calibration_policy: Ref | None = None
+    canonical_forecast_id: Ref | None = None
+    budget: Minutes | None = None
+
+
+class Completion(Model):
+    complete: bool
+    completed_at: Instant | None = None
+    known_at: Instant
+    basis: Ref
+
+
+class Coverage(Model):
+    reason: Ref | None = None
+    state: Literal["complete", "partial", "unknown", "unavailable"]
+    known_at: Instant
+    basis: Ref
+
+
+class Scope(Model):
+    episode_id: Ref
+    scope_id: Ref
+    task_family: Ref
+    scope_kind: Literal["whole_episode", "remaining_episode"]
+    baseline_policy: Ref
+
+
+class HistoryScope(Scope):
+    history_id: Ref
+    user_id: Ref
+    scope_start_at: Instant
+    scope_end_at: Instant
+    completion: Completion
+    coverage: Coverage
+    forecasts: tuple[Issued, ...] = Field(max_length=80)
+    observations: tuple[Reading, ...] = Field(max_length=256)
+    disjoint_subscope_coverage: bool = False
+
+    @model_validator(mode="after")
+    def chronology(self):
+        if (
+            self.scope_end_at < self.scope_start_at
+            or self.completion.complete
+            and (
+                self.completion.completed_at is None
+                or self.completion.completed_at < self.scope_end_at
+                or self.completion.known_at < self.completion.completed_at
+            )
+        ):
+            raise ValueError("Inconsistent measured scope and completion chronology.")
+        return self
+
+
+def selected_actual(scope, cutoff):
+    """Select a revision before reducing a measured scope. Preserve genuine zero."""
+    groups = {}
+    for row in scope.observations:
+        if row.known_at <= cutoff and row.scope_id == scope.scope_id:
+            groups.setdefault(row.logical_observation_id or row.observation_id, []).append(row)
+    rows = []
+    for revisions in groups.values():
+        highest = max(r.revision for r in revisions)
+        current = [r for r in revisions if r.revision == highest]
+        if any(
+            r.model_dump(exclude={"observation_id"})
+            != current[0].model_dump(exclude={"observation_id"})
+            for r in current[1:]
+        ):
+            return None, [], [], "conflicting_observation_revision"
+        if not current[0].retracted:
+            rows.append(current[0])
+    refs = sorted(f"{r.observation_id}@{r.revision}" for r in rows)
+    if not rows:
+        return None, refs, [], "missing_actual_observations"
+    totals = [r for r in rows if r.kind == "duration_total"]
+    intervals = [r for r in rows if r.kind == "active_interval"]
+    if len(totals) > 1:
+        return None, refs, [], "ambiguous_multiple_totals"
+    if totals and not intervals:
+        return Fraction(totals[0].minutes), refs, [], None
+    if totals and (
+        not totals[0].representation_group
+        or any(r.representation_group != totals[0].representation_group for r in intervals)
+    ):
+        return None, refs, [], "mixed_actual_representations"
+    from canvas_bridge.planning import subtract
+
+    covered = []
+    for row in intervals:
+        if row.start < scope.scope_start_at or row.end > scope.scope_end_at:
+            return None, refs, [], "interval_outside_actual_scope"
+        chunks = [(row.start, row.end)]
+        for pause in row.pauses:
+            chunks = subtract(chunks, pause.start, pause.end)
+        covered.extend(chunks)
+    spans = union(covered)
+    minutes = sum((elapsed(s, e) for s, e in spans), Fraction())
+    if totals and minutes != totals[0].minutes:
+        return None, refs, spans, "conflicting_linked_measurements"
+    return minutes, refs, spans, None
+
+
+def stage6_scope(actual: Actual, forecast: Forecast, *, owner, family, policy):
+    """Adapt already authorized Stage 6 records; historical frozen values stay immutable."""
+    if (actual.forecast_id, actual.forecast_version, set(actual.course_ids)) != (
+        forecast.key,
+        forecast.version,
+        set(forecast.course_ids),
+    ):
+        raise ValueError("Forecast reference or course does not match the actual.")
+    if forecast.origin not in {
+        "student_estimate",
+        "instructor_estimate",
+        "rule_of_thumb",
+        "assistant_estimate",
+    }:
+        raise ValueError("Unrecognized original Stage 6 estimate basis.")
+    reason = mismatch(actual, forecast)
+    if reason:
+        raise ValueError(reason)
+    start = forecast.effective_at or forecast.observed_at
+    duration = (
+        actual.minutes - (actual.minutes_before_scope or 0)
+        if actual.duration_basis == "cumulative"
+        else actual.minutes
+    )
+    scope_start = start if actual.duration_basis == "cumulative" else actual.start
+    return HistoryScope(
+        history_id=actual.key,
+        user_id=owner,
+        episode_id=actual.unit_id,
+        scope_id=actual.scope_id,
+        scope_kind="remaining_episode"
+        if forecast.scope_kind == "remaining_work"
+        else "whole_episode",
+        task_family=family,
+        baseline_policy=policy,
+        scope_start_at=scope_start,
+        scope_end_at=actual.completion or actual.start,
+        completion=Completion(
+            complete=actual.completed,
+            completed_at=actual.completion,
+            known_at=actual.observed_at,
+            basis=actual.basis,
+        ),
+        coverage=Coverage(
+            state="complete" if actual.complete_duration else "partial",
+            known_at=actual.observed_at,
+            basis=actual.basis,
+        ),
+        forecasts=[
+            Issued(
+                forecast_id=forecast.key,
+                scope_id=forecast.scope_id,
+                frozen_at=start,
+                known_at=forecast.observed_at,
+                baseline_policy=policy,
+                baseline_origin=forecast.origin,
+                baseline=Estimate(
+                    low=forecast.minimum, high=forecast.maximum, point=forecast.point
+                ),
+                published=Estimate(
+                    low=forecast.minimum, high=forecast.maximum, point=forecast.point
+                ),
+                budget=forecast.budget,
+            )
+        ],
+        observations=[
+            Reading(
+                observation_id=actual.key,
+                scope_id=actual.scope_id,
+                revision=actual.version,
+                known_at=actual.observed_at,
+                kind="duration_total",
+                basis=actual.basis,
+                minutes=duration,
+            )
+        ],
+    )
diff --git a/src/canvas_bridge/analytics/personal_forecast.py b/src/canvas_bridge/analytics/personal_forecast.py
new file mode 100644
--- /dev/null
+++ b/src/canvas_bridge/analytics/personal_forecast.py
@@ -0,0 +1,295 @@
+"""Prospective, episode-scoped effort calibration from independent measured scopes."""
+
+from collections import defaultdict
+from fractions import Fraction
+from math import ceil, floor
+from statistics import median
+
+from canvas_bridge.analytics.effort_history import (
+    Estimate,
+    HistoryScope,
+    Instant,
+    Scope,
+    selected_actual,
+)
+from canvas_bridge.evidence import fingerprint
+from canvas_bridge.processes.models import Model, Ref
+
+
+class Override(Model):
+    override_id: Ref
+    scope_id: Ref
+    episode_id: Ref
+    known_at: Instant
+    values: Estimate
+    basis: Ref
+
+
+class Target(Scope):
+    forecast_id: Ref
+    user_id: Ref
+    cutoff: Instant
+    baseline: Estimate
+    baseline_origin: Ref
+    manual_override: Override | None = None
+    completed: bool = False
+
+
+def metric(actual, values, budget):
+    return dict(
+        point_error_minutes=float(actual - values.point) if values.point is not None else None,
+        absolute_point_error_minutes=float(abs(actual - values.point))
+        if values.point is not None
+        else None,
+        inside_range=values.low <= actual <= values.high if values.low is not None else None,
+        budget_error_minutes=float(actual - budget) if budget is not None else None,
+        absolute_budget_error_minutes=float(abs(actual - budget)) if budget is not None else None,
+    )
+
+
+def evaluate_frozen(scope, cutoff):
+    """Score each distinct prospective issue against the actual known at this cutoff."""
+    if (
+        not scope.completion.complete
+        or scope.completion.known_at > cutoff
+        or scope.coverage.state != "complete"
+        or scope.coverage.known_at > cutoff
+    ):
+        return []
+    actual, refs, _, reason = selected_actual(scope, cutoff)
+    if reason:
+        return []
+    result = []
+    seen = set()
+    for f in scope.forecasts:
+        key = f.canonical_forecast_id or f.forecast_id
+        if (
+            key in seen
+            or f.scope_id != scope.scope_id
+            or not f.frozen_at <= f.known_at <= min(cutoff, scope.scope_start_at)
+        ):
+            continue
+        seen.add(key)
+        result.append(
+            dict(
+                forecast_id=f.forecast_id,
+                scope_id=scope.scope_id,
+                episode_id=scope.episode_id,
+                observation_refs=refs,
+                actual_minutes=float(actual),
+                evaluation_cutoff=cutoff.isoformat(),
+                baseline=metric(actual, f.baseline, f.baseline.high),
+                published=metric(actual, f.published, f.budget),
+            )
+        )
+    return result
+
+
+def candidate(scope, target):
+    if (scope.episode_id, scope.scope_id) == (target.episode_id, target.scope_id):
+        return None, "target_outcome"
+    for key in ("user_id", "task_family", "scope_kind", "baseline_policy"):
+        if getattr(scope, key) != getattr(target, key):
+            return None, "cohort_" + key
+    if not scope.completion.complete:
+        return None, "unfinished_scope"
+    if scope.completion.completed_at > target.cutoff:
+        return None, "completion_after_cutoff"
+    if scope.completion.known_at > target.cutoff:
+        return None, "completion_not_known_at_cutoff"
+    if scope.coverage.state != "complete" or scope.coverage.known_at > target.cutoff:
+        return None, "incomplete_actual_coverage"
+    prospective = [
+        f
+        for f in scope.forecasts
+        if f.baseline_policy == target.baseline_policy
+        and f.scope_id == scope.scope_id
+        and f.frozen_at <= scope.scope_start_at
+        and f.frozen_at <= f.known_at <= min(target.cutoff, scope.scope_start_at)
+    ]
+    if not prospective:
+        return None, "missing_prospective_baseline"
+    f = min(prospective, key=lambda f: (-f.frozen_at.timestamp(), f.forecast_id))
+    minutes, refs, spans, reason = selected_actual(scope, target.cutoff)
+    if reason:
+        return None, reason
+    return (scope, f, minutes, refs, spans), None
+
+
+def forecast(histories: list[HistoryScope], target: Target):
+    pairs = []
+    excluded = []
+
+    def omit(scope, reason):
+        excluded.append(dict(history_id=scope.history_id, reason=reason))
+
+    # Active sessions for different episodes cannot both own the same elapsed minutes.
+    sessions = defaultdict(list)
+    ambiguous = set()
+    for scope in histories:
+        if scope.user_id != target.user_id:
+            continue
+        _, _, spans, _ = selected_actual(scope, target.cutoff)
+        for start, end in spans:
+            sessions[scope.episode_id].append((start, end, scope.history_id))
+    # Sweep rather than comparing every pair of intervals in a large history.
+    live = []
+    for start, end, episode, key in sorted(
+        (s, e, ep, k) for ep, ss in sessions.items() for s, e, k in ss
+    ):
+        live = [item for item in live if item[0] > start]
+        for _, other, prior in live:
+            if other != episode:
+                ambiguous.update((key, prior))
+        live.append((end, episode, key))
+    for scope in histories:
+        pair, reason = candidate(scope, target)
+        if scope.history_id in ambiguous:
+            reason = "cross_episode_overlap"
+        if reason:
+            omit(scope, reason)
+        else:
+            pairs.append(pair)
+    pairs.sort(
+        key=lambda p: (
+            -p[0].completion.completed_at.timestamp(),
+            -p[0].scope_start_at.timestamp(),
+            -p[1].frozen_at.timestamp(),
+            p[0].history_id,
+        )
+    )
+    training = []
+    seen = set()
+    evaluation = []
+    for pair in pairs:
+        scope, f, actual, refs, _ = pair
+        key = (scope.episode_id, scope.scope_id, f.canonical_forecast_id or f.forecast_id)
+        if key in seen:
+            omit(scope, "duplicate_forecast_actual_pair")
+            continue
+        seen.add(key)
+        evaluation.append(
+            dict(
+                history_id=scope.history_id,
+                forecast_id=f.forecast_id,
+                actual_minutes=float(actual),
+                observation_refs=refs,
+                baseline=metric(actual, f.baseline, f.baseline.high),
+                published=metric(
+                    actual, f.published, f.budget if f.budget is not None else f.published.high
+                ),
+            )
+        )
+        if not f.baseline.point:
+            omit(
+                scope,
+                "missing_baseline_point" if f.baseline.point is None else "zero_baseline_point",
+            )
+            continue
+        reason = None
+        for prior, *_ in training:
+            if prior.episode_id != scope.episode_id:
+                continue
+            if prior.scope_id == scope.scope_id:
+                reason = "duplicate_completed_scope"
+            elif (
+                prior.scope_start_at < scope.scope_end_at
+                and scope.scope_start_at < prior.scope_end_at
+            ):
+                reason = "overlapping_completed_scope"
+            elif not (scope.disjoint_subscope_coverage and prior.disjoint_subscope_coverage):
+                reason = "unverified_independent_subscope"
+            if reason:
+                break
+        if reason:
+            omit(scope, reason)
+        else:
+            training.append(pair)
+    training.sort(
+        key=lambda p: (-p[0].completion.completed_at.timestamp(), p[0].episode_id, p[0].scope_id)
+    )
+    for scope, *_ in training[20:]:
+        omit(scope, "history_limit")
+    training = training[:20]
+    ratios = [actual / f.baseline.point for _, f, actual, _, _ in training]
+    n = len(ratios)
+    middle = median(ratios) if n else None
+    factor = (3 + n * middle) / (3 + n) if n else Fraction(1)
+    raw = {
+        k: None if value is None else value * factor
+        for k, value in target.baseline.model_dump().items()
+    }
+    unknown = raw["low"] is None
+    if target.completed:
+        raw = dict.fromkeys(raw, Fraction(0))
+        suggestion = Estimate(low=0, point=0, high=0)
+        state = "completed_or_zero_remaining"
+    elif unknown:
+        suggestion = Estimate()
+        state = "baseline_unknown"
+    else:
+        low = max(1, floor(raw["low"]))
+        high = max(low, ceil(raw["high"]))
+        if high > 100_000:
+            raise ValueError("Forecast exceeds the supported planner range.")
+        point = (
+            min(high, max(low, floor(raw["point"] + Fraction(1, 2))))
+            if raw["point"] is not None
+            else None
+        )
+        suggestion = Estimate(low=low, point=point, high=high)
+        state = "range_only" if point is None else "point_and_range"
+    effective = suggestion
+    override = target.manual_override
+    override_state = "absent"
+    if override:
+        if target.completed:
+            override_state = "inapplicable_completed_scope"
+        elif (override.scope_id, override.episode_id) == (
+            target.scope_id,
+            target.episode_id,
+        ) and override.known_at <= target.cutoff:
+            effective = override.values
+            override_state = "applied"
+        else:
+            override_state = "outside_current_scope_or_cutoff"
+    support = "cold_start" if not n else "limited_history" if n < 3 else "supported_history"
+    return dict(
+        forecast_id=target.forecast_id,
+        scope_id=target.scope_id,
+        episode_id=target.episode_id,
+        cutoff=target.cutoff.isoformat(),
+        policy="median_ratio_shrinkage_v1",
+        baseline=target.baseline.model_dump(),
+        baseline_origin=target.baseline_origin,
+        baseline_state=state,
+        matched_pair_count=len(evaluation),
+        training_count=n,
+        training_history_ids=[p[0].history_id for p in training],
+        training_forecast_ids=[p[1].forecast_id for p in training],
+        training_snapshot_id=fingerprint(
+            [(p[0].history_id, p[1].forecast_id, str(p[2]), p[3]) for p in training]
+        ),
+        actual_minutes={p["history_id"]: p["actual_minutes"] for p in evaluation},
+        ratio_median=str(middle) if n else None,
+        factor=str(factor),
+        raw={k: str(v) if v is not None else None for k, v in raw.items()},
+        calibration_suggestion=suggestion.model_dump(),
+        published=effective.model_dump(),
+        planning_budget_minutes=effective.high,
+        override_state=override_state,
+        history_support=support,
+        support="user_override"
+        if override_state == "applied"
+        else state
+        if state == "baseline_unknown"
+        else support,
+        excluded=excluded,
+        evaluations=evaluation,
+        metric_denominators={
+            k: sum(
+                p["published"][k] is not None and p["baseline"][k] is not None for p in evaluation
+            )
+            for k in ("point_error_minutes", "inside_range", "budget_error_minutes")
+        },
+    )
