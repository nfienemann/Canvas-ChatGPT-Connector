+                owner,
+                cs.Reassessment(
+                    record_id=rid,
+                    expected_revision=staged["revision"],
+                    change_id=staged["change_id"],
+                    idempotency_key="change" + str(i),
+                    assessments=review(bindings, file).requirements if i else (),
+                    inventory_complete=True,
+                ),
