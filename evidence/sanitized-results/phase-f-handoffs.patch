+    packets = [original]
+    receipts = []
+    revision = 1
+    for i, file in enumerate(("handoff_v1", "handoff_v2")):
+        raw = content("fixtures/model_inputs/" + file + ".md")
+        if i == 0:
+            raw = b"\n" + raw
+        ident = await bridge.independent.ingest(
