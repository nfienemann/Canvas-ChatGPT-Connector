+                if ident == "PA-R04"
+                else None,
+            )
+        )
+    return Review(
+        assignment_id="primary",
+        course="BenchLink",
+        term="fall-2026",
+        expected_revision=0,
+        idempotency_key=label,
+        membership_complete=True,
+        review_scope="Assignment brief",
+        bindings=bindings,
+        requirements=rows,
