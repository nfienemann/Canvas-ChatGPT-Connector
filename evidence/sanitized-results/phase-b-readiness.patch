+        owner,
+        request.record_id,
+        request.expected_revision,
+        request.idempotency_key,
+        fingerprint(request.model_dump(mode="json")),
+        build,
+    )
+    return Result(
+        summary="Personal progress saved. The artifact retains its assessed result.", data=receipt
+    )
