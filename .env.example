# Copy into private operator configuration. Never commit real values.
BRIDGE_PROFILE=synthetic
BRIDGE_DATABASE_URL=postgresql+psycopg://bridge:CHANGE_ME@localhost:5432/bridge
BRIDGE_RESOURCE_URL=http://127.0.0.1:8000
BRIDGE_ISSUER_URL=https://YOUR_IDENTITY_PROVIDER/
BRIDGE_JWKS_URL=https://YOUR_IDENTITY_PROVIDER/.well-known/jwks.json
BRIDGE_VAULT_KEY_FILE=/run/secrets/bridge-vault-key
BRIDGE_INSTITUTIONS_FILE=institutions.json
BRIDGE_LIVE_ACCESS_ENABLED=false
# Opt-in isolated document extraction; supported Windows/Linux deployments only.
BRIDGE_FILE_READING_ENABLED=false
# Private local directory, outside the repository and cloud-synced folders.
# BRIDGE_PARSER_ROOT=C:/Users/YOU/AppData/Local/CanvasBridge/parser
# Linux containers prebuild trusted code separately from non-executable jobs:
# BRIDGE_PARSER_RUNTIME_ROOT=/opt/canvas-parser
# Optional trusted Tesseract 5 root containing tessdata/eng.traineddata.
# Windows also needs installed DLLs; Linux image configures this automatically.
# BRIDGE_OCR_ROOT=C:/Users/YOU/AppData/Local/CanvasBridge/tesseract
BRIDGE_FILE_CACHE_HOURS=24
# Original delivery is independent of parser availability. One API process per root.
BRIDGE_FILE_DELIVERY_ENABLED=true
# Set a private, writable folder outside source control/cloud sync (required for read-only secrets mounts).
# BRIDGE_FILE_DELIVERY_ROOT=C:/Users/YOU/AppData/Local/CanvasBridge/original-delivery
BRIDGE_FILE_DELIVERY_MAX_BYTES=52428800
BRIDGE_FILE_DELIVERY_INLINE_BYTES=131072
BRIDGE_FILE_DELIVERY_TTL_SECONDS=300
BRIDGE_FILE_DELIVERY_STAGING_BYTES=536870912
BRIDGE_FILE_DELIVERY_BUDGET_SECONDS=90
# Personal developer proof only: exact subject from the configured identity provider.
# Leave unset for synthetic/hosted profiles. Never put a Canvas token in this file.
# BRIDGE_PERSONAL_SUBJECT=YOUR_IDENTITY_PROVIDER_SUBJECT
# Optional first-read configuration: omit saved-plan/preferences/progress MCP tools.
# BRIDGE_MCP_READ_ONLY=true
# Default requires RFC 9207 iss on browser OAuth callbacks. For providers without
# it, false uses an issuer-specific redirect instead. Register the exact callback
# URL reported by doctor; never use wildcard redirects.
# BRIDGE_BROWSER_REQUIRE_ISSUER_PARAMETER=false
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8000
