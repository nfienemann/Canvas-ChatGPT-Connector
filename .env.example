# Copy into private operator configuration. Never commit real values.
BRIDGE_PROFILE=synthetic
BRIDGE_DATABASE_URL=postgresql+psycopg://bridge:CHANGE_ME@localhost:5432/bridge
BRIDGE_RESOURCE_URL=http://127.0.0.1:8000
BRIDGE_ISSUER_URL=https://YOUR_IDENTITY_PROVIDER/
BRIDGE_JWKS_URL=https://YOUR_IDENTITY_PROVIDER/.well-known/jwks.json
BRIDGE_VAULT_KEY_FILE=/run/secrets/bridge-vault-key
BRIDGE_INSTITUTIONS_FILE=institutions.json
BRIDGE_LIVE_ACCESS_ENABLED=false
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8000
