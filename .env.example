# Copy into private operator configuration. Never commit real values.
BRIDGE_PROFILE=synthetic
BRIDGE_DATABASE_URL=postgresql+psycopg://bridge:CHANGE_ME@localhost:5432/bridge
BRIDGE_RESOURCE_URL=http://127.0.0.1:8000
BRIDGE_ISSUER_URL=https://YOUR_IDENTITY_PROVIDER/
BRIDGE_JWKS_URL=https://YOUR_IDENTITY_PROVIDER/.well-known/jwks.json
BRIDGE_VAULT_KEY_FILE=/run/secrets/bridge-vault-key
BRIDGE_INSTITUTIONS_FILE=institutions.json
BRIDGE_LIVE_ACCESS_ENABLED=false
# Opt-in academic process workflows; grants no institutional or publication rights.
# See docs/process-specifications/implementation.md. Read-only mode omits local mutations.
BRIDGE_PROCESS_FEATURES_ENABLED=false
# Maximum accepted application JWT lifetime; may be lowered, never above one hour.
BRIDGE_APPLICATION_TOKEN_MAX_SECONDS=3600
# Institution-specific OAuth capabilities and workflow controls are documented in
# docs/identity-oauth-hardening.md. They do not supply upstream approvals.
# Paths only: flags, credentials and registry status never grant authorization.
# Provision only after independently obtaining and verifying the required approvals.
# Service account: read-only ACLs. Signing/evidence-decryption keys stay off-service.
# BRIDGE_APPROVAL_TRUST_FILE=C:/ProgramData/CanvasBridgePolicy/trust.json
# BRIDGE_APPROVAL_RECORDS_FILE=C:/ProgramData/CanvasBridgePolicy/approvals.json
# BRIDGE_APPROVAL_EVIDENCE_ROOT=C:/ProgramData/CanvasBridgePolicy/evidence
# Exact registered ChatGPT OAuth client IDs; this does not supply sharing approval.
# BRIDGE_MCP_CHATGPT_CLIENT_IDS=["REVIEWED_REGISTERED_CLIENT_ID"]
# Opt-in isolated document extraction; supported Windows/Linux deployments only.
BRIDGE_FILE_READING_ENABLED=false
# PPTX source budget only. Other supported readers retain their 10,000,000-byte cap.
# ZIP expansion/XML/worker/output budgets remain separate hard ceilings.
BRIDGE_PPTX_SOURCE_MAX_BYTES=33554432
BRIDGE_PPTX_DOWNLOAD_BUDGET_SECONDS=60
# Experimental Windows converter. Keep disabled until local sandbox rendering,
# fidelity and client-visible pixels are verified. No native runtime is bundled.
BRIDGE_PPTX_RENDERING_ENABLED=false
# BRIDGE_PPTX_RENDERER_ROOT=C:/trusted-public-libreoffice-runtime
# Private local directory, outside the repository and cloud-synced folders.
# BRIDGE_PARSER_ROOT=C:/Users/YOU/AppData/Local/CanvasBridge/parser
# Linux containers prebuild trusted code separately from non-executable jobs:
# BRIDGE_PARSER_RUNTIME_ROOT=/opt/canvas-parser
# Optional trusted Tesseract 5 root containing tessdata/eng.traineddata.
# Windows also needs installed DLLs; Linux image configures this automatically.
# BRIDGE_OCR_ROOT=C:/Users/YOU/AppData/Local/CanvasBridge/tesseract
BRIDGE_FILE_CACHE_HOURS=24
# Optional, private client-build evidence; missing/invalid evidence stays unknown.
# BRIDGE_VISUAL_CLIENT_EVIDENCE_FILE=C:/Users/YOU/AppData/Local/CanvasBridge/visual-clients.json
BRIDGE_VISUAL_CANDIDATE_PAGES=40
BRIDGE_VISUAL_CANDIDATE_LIMIT=6
BRIDGE_VISUAL_RENDER_ATTEMPTS=3
BRIDGE_VISUAL_TOTAL_IMAGE_BYTES=3900000
BRIDGE_VISUAL_EXECUTION_SECONDS=90
# Can lower the PDF rendering worker ceiling; cannot exceed the existing 384 MiB cap.
BRIDGE_VISUAL_WORKER_MEMORY_MB=384
# Original delivery is independent of parser availability. One API process per root.
BRIDGE_FILE_DELIVERY_ENABLED=true
# Set a private, writable folder outside source control/cloud sync (required for read-only secrets mounts).
# BRIDGE_FILE_DELIVERY_ROOT=C:/Users/YOU/AppData/Local/CanvasBridge/original-delivery
BRIDGE_FILE_DELIVERY_MAX_BYTES=52428800
BRIDGE_FILE_DELIVERY_INLINE_BYTES=131072
BRIDGE_FILE_DELIVERY_TTL_SECONDS=300
BRIDGE_FILE_DELIVERY_STAGING_BYTES=536870912
BRIDGE_FILE_DELIVERY_BUDGET_SECONDS=90
# Personal developer proof only: exact subject from the configured identity provider.
# Leave unset for synthetic/hosted profiles. Never put a Canvas token in this file.
# BRIDGE_PERSONAL_SUBJECT=YOUR_IDENTITY_PROVIDER_SUBJECT
# Optional first-read configuration: omit saved-plan/preferences/progress MCP tools.
# BRIDGE_MCP_READ_ONLY=true
# Default requires RFC 9207 iss on browser OAuth callbacks. For providers without
# it, false uses an issuer-specific redirect instead. Register the exact callback
# URL reported by doctor; never use wildcard redirects.
# BRIDGE_BROWSER_REQUIRE_ISSUER_PARAMETER=false
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8000

# Operator pseudonym rotation revision; does not disable privacy or authorize access.
BRIDGE_PRIVACY_PSEUDONYM_REVISION=1

# Independent content does not require institutional approval. These settings
# never grant provider or institution authorization.
# BRIDGE_CAPABILITY_PROFILE=offline_research
# BRIDGE_INDEPENDENT_EGRESS_FILE=/private/operator/independent-recipient.json
BRIDGE_INDEPENDENT_RETENTION_HOURS=24
